<?xml version="1.0" encoding="utf-8"?><!--
   What Android backs up (Android 12 and newer): to your Google account (cloud-backup), and when you
   move to a new phone (device-transfer). Only what's listed is copied:
   - the app's settings, notes, timers, WikiSync name and so on (shared preferences)
   - your Inventory Setups pictures
   Nothing else needs it (see backup_rules.xml).
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="file" path="setups/" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="file" path="setups/" />
    </device-transfer>
</data-extraction-rules>
